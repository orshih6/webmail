# source dev/dev.env before `cargo run` / `cargo test` against the dev stack (dev/up.sh)
export DATABASE_URL=postgres://postgres:webmail@localhost:5434/webmail
export IMAP_HOST=localhost IMAP_PORT=3993 SMTP_HOST=localhost SMTP_PORT=3465
export TLS_ACCEPT_INVALID_CERTS=1
export COOKIE_SECURE=0
export MAIL_TIMEOUT_SECS=5  # fail fast in dev/tests (default 30)
