# Copy to .env and fill in. Only IMAP_HOST is required.

# Your mail server. Webmail speaks implicit TLS only: IMAPS (993) and SMTPS (465).
IMAP_HOST=mail.example.com
# SMTP_HOST=mail.example.com      # defaults to IMAP_HOST
# IMAP_PORT=993
# SMTP_PORT=465

# Name shown in the UI, page titles and the installed app.
# APP_NAME=Webmail

# Database password (Postgres is not exposed outside the compose network).
# POSTGRES_PASSWORD=change-me

# Where the app listens on this machine. 127.0.0.1 keeps it local; use 0.0.0.0 only
# behind an HTTPS reverse proxy.
# WEBMAIL_BIND=127.0.0.1
# WEBMAIL_PORT=8080

# Session cookies are Secure. Browsers accept that on http://localhost; if yours does not
# (or you test from another machine over plain http), set 0 — for testing only.
# COOKIE_SECURE=1

# Only for a test mail server with a self-signed certificate. Never in production.
# TLS_ACCEPT_INVALID_CERTS=0

# If you run a modified version for others, point this at your source (AGPL-3.0 §13).
# SOURCE_URL=https://github.com/orshih6/webmail

# MAIL_TIMEOUT_SECS=30
# MESSAGE_CACHE_MB=64
